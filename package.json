{
  "name": "oku",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run bake",
    "test": "npm run typecheck && node --experimental-strip-types scripts/test-interpolate.ts && node --experimental-strip-types scripts/test-resolve-media.ts && node --experimental-strip-types scripts/test-keyframe-yaml.ts && node --experimental-strip-types scripts/test-flyover.ts && node --experimental-strip-types scripts/test-panorama.ts && node --experimental-strip-types scripts/validate-fixtures.ts",
    "validate": "node --experimental-strip-types scripts/validate-fixtures.ts",
    "migrate": "node --experimental-strip-types scripts/migrate-legacy.ts",
    "bake": "node --experimental-strip-types scripts/build-trips.ts",
    "prebuild": "npm run bake",
    "predev": "npm run bake",
    "upload-media": "node --experimental-strip-types scripts/upload-media.ts",
    "preview:remote": "opennextjs-cloudflare build && wrangler dev --remote"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "js-yaml": "^4.1.0",
    "mapbox-gl": "^3.28.1",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260808.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/js-yaml": "^4.0.9",
    "@types/mapbox-gl": "^3.5.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.120.0"
  }
}
