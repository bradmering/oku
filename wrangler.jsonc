{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "oku",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },

  // Media lives in R2 — egress is the only cost that ever becomes structural
  // for a read-heavy, media-heavy product. Bucket created 2026-08-08; nothing
  // reads it yet.
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "oku-media" }
  ]
}
